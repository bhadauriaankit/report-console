# Copy to .env and adjust.

PORT=4000

# ── Authentication ──────────────────────────────────────────────
# Admin direct login credentials (for admin access without Microsoft)
ADMIN_USER=admin
ADMIN_PASSWORD=Admin@1234

# Session security secret (change to a long random string in production!)
SESSION_SECRET=change-me-to-a-long-random-string

# Microsoft Azure AD / Entra ID OAuth (for Sign in with Microsoft + 2FA)
# Get these from https://portal.azure.com → App registrations → New registration
# Leave AZURE_CLIENT_ID / AZURE_CLIENT_SECRET empty to disable Microsoft login
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:4000/api/auth/callback

# Frontend URL (used for redirecting after callback)
FRONTEND_URL=http://localhost:5175

# ── Email OTP 2FA (SMTP) ─────────────────────────────────────────
# Optional: Set these to send real email OTPs (e.g. Gmail, Outlook, company SMTP)
# If left empty, 2FA OTP codes will be printed directly to the backend terminal for dev testing!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="Report Portal" <no-reply@mycompany.com>

# Shared secret Scaler's HTTP Caller must send in the X-Callback-Secret header.
# Leave empty to disable the check (fine for local testing only).
CALLBACK_SECRET=change-me

# Allowed browser origin(s) for the React app, comma separated
CORS_ORIGIN=http://localhost:5173

# Scaler HTTP Input URL. The backend POSTs { requestId, reportType, status } here.
SCALER_URL=http://localhost:30800/rest/api/submit-job/reports
# Optional Authorization header value for Scaler, e.g. "Bearer xxx". Leave empty if not needed.
SCALER_AUTH=

# Options shown in the GUI dropdowns (comma separated)
REPORT_TYPES=statement,transaction,annual_statement,enrollment,invoice
REPORT_STATUSES=COMPLETE,PENDING,FAILED

# PostgreSQL connection for Live Monitor
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
# PG_SSL=true

# SFTP Remote Storage configuration (for remote HTML and attachment storage)
SFTP_ENABLED=false
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=my_sftp_user
SFTP_PASSWORD=my_sftp_password
# SFTP_KEY_PATH=/path/to/private_key.pem
# SFTP_BASE_PATH=/reports

