# Copy to .env and adjust.

PORT=4000

# Shared secret Scaler's HTTP Caller must send in the X-Callback-Secret header.
# Leave empty to disable the check (fine for local testing only).
CALLBACK_SECRET=change-me

# Allowed browser origin(s) for the React app, comma separated
CORS_ORIGIN=http://localhost:5173

# Scaler HTTP Input URL. The backend POSTs { requestId, reportType, status } here.
SCALER_URL=http://localhost:30800/rest/api/submit-job/reports
# Optional Authorization header value for Scaler, e.g. "Bearer xxx". Leave empty if not needed.
SCALER_AUTH=

# Options shown in the GUI dropdowns (comma separated)
REPORT_TYPES=statement,transaction,annual_statement,enrollment,invoice
REPORT_STATUSES=COMPLETE,PENDING,FAILED

# PostgreSQL connection for Live Monitor
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=
# PG_SSL=true

# SFTP Remote Storage configuration (for remote HTML and attachment storage)
SFTP_ENABLED=false
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USER=my_sftp_user
SFTP_PASSWORD=my_sftp_password
# SFTP_KEY_PATH=/path/to/private_key.pem
# SFTP_BASE_PATH=/reports

